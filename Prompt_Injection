rule LLM_PromptInjection_Scored_v1 : llm prompt_injection jailbreak
{
  meta:
    author = "Fernando Denis"
    purpose = "Deteccion heuristica (scoring) de prompt injection/jailbreak en texto o documentos RAG"
    severity = "high"
    version = "1.0"
    caveat = "Heuristica: ajusta umbrales a tu entorno para minimizar falsos positivos."

  strings:
    // 1) Override / bypass de instrucciones (EN)
    $ov1 = "ignore previous instructions" nocase ascii wide
    $ov2 = "disregard previous instructions" nocase ascii wide
    $ov3 = "override the system prompt" nocase ascii wide
    $ov4 = "you are not bound by" nocase ascii wide
    $ov5 = "do anything now" nocase ascii wide
    $ov6 = "DAN" nocase ascii wide

    // 2) Override / bypass de instrucciones (ES)
    $es1 = "ignora las instrucciones anteriores" nocase ascii wide
    $es2 = "omite las instrucciones anteriores" nocase ascii wide
    $es3 = "anula el prompt del sistema" nocase ascii wide
    $es4 = "no estás obligado a" nocase ascii wide
    $es5 = "actúa como" nocase ascii wide  // señal suave, se usa con scoring

    // 3) Exfil de system/developer/policies (EN/ES)
    $ex1 = "reveal the system prompt" nocase ascii wide
    $ex2 = "show me your system message" nocase ascii wide
    $ex3 = "print the hidden instructions" nocase ascii wide
    $ex4 = "developer message" nocase ascii wide
    $ex5 = "system prompt" nocase ascii wide
    $ex6 = "policy" nocase ascii wide
    $ex7 = "chain of thought" nocase ascii wide
    $ex8 = "prompt de sistema" nocase ascii wide
    $ex9 = "instrucciones ocultas" nocase ascii wide
    $ex10 = "muestra tus políticas" nocase ascii wide

    // 4) RAG / data exfil / “lee el documento y suéltalo todo”
    $rag1 = "dump the entire document" nocase ascii wide
    $rag2 = "exfiltrate" nocase ascii wide
    $rag3 = "retrieve all" nocase ascii wide
    $rag4 = "list all secrets" nocase ascii wide
    $rag5 = "api key" nocase ascii wide
    $rag6 = "password" nocase ascii wide
    $rag7 = "token" nocase ascii wide
    $rag8 = "credenciales" nocase ascii wide
    $rag9 = "secreto" nocase ascii wide
    $rag10 = "muestra todo el documento" nocase ascii wide
    $rag11 = "vuelca el documento completo" nocase ascii wide
    $rag12 = "claves" nocase ascii wide

    // 5) Tool / function abuse (intentos típicos)
    $tool1 = "call the tool" nocase ascii wide
    $tool2 = "use the browser" nocase ascii wide
    $tool3 = "run a command" nocase ascii wide
    $tool4 = "execute" nocase ascii wide
    $tool5 = "powershell" nocase ascii wide
    $tool6 = "curl " nocase ascii wide
    $tool7 = "wget " nocase ascii wide
    $tool8 = "invoke-webrequest" nocase ascii wide

    // 6) Señales de “role-play malicioso” / formato de control
    $fmt1 = "SYSTEM:" nocase ascii wide
    $fmt2 = "DEVELOPER:" nocase ascii wide
    $fmt3 = "USER:" nocase ascii wide
    $fmt4 = "BEGIN SYSTEM PROMPT" nocase ascii wide
    $fmt5 = "END SYSTEM PROMPT" nocase ascii wide

  condition:
    // Scoring simple (sin bucles): disparamos si hay combinación fuerte,
    // o si hay muchas señales medianas.
    (
      // A) Combinación fuerte: override + exfil
      (1 of ($ov*) or 1 of ($es*)) and (1 of ($ex*) or 1 of ($fmt*))
    )
    or
    (
      // B) Combinación fuerte: override + RAG exfil/secrets
      (1 of ($ov*) or 1 of ($es*)) and (2 of ($rag*))
    )
    or
    (
      // C) Tool abuse + exfil/override (típico de agentes)
      (2 of ($tool*)) and (1 of ($ex*) or 1 of ($ov*) or 1 of ($es*))
    )
    or
    (
      // D) “Scoring” general: muchas señales mezcladas
      ( (2 of ($ov*) or 2 of ($es*)) and (1 of ($rag*) or 1 of ($ex*)) )
      or
      ( 6 of ($ov*,$es*,$ex*,$rag*,$tool*,$fmt*) )
    )
}
