// Text that is invisible to the user but read by the model: indirect prompt
// injection hidden in pasted web pages, emails or documents.

rule Unicode_Tag_Smuggling : prompt_injection hidden_text
{
    meta:
        description = "Invisible Unicode tag characters spelling hidden text (ASCII smuggling)"
        severity = "high"
        action = "block"
        category = "prompt_injection"
        note = "Flag emoji subdivision sequences only use lowercase tag letters, so they do not trigger this detection"
    strings:
        // U+E0020 TAG SPACE in UTF-8
        $tag_space = { F3 A0 80 A0 }
        // U+E0041..U+E005A TAG LATIN CAPITAL LETTER A..Z in UTF-8
        $tag_upper = /\xF3\xA0\x81[\x81-\x9A]/
    condition:
        $tag_space or #tag_upper >= 2
}

rule Bidi_Override_Characters : prompt_injection hidden_text
{
    meta:
        description = "Unicode bidirectional override characters that make the displayed text differ from what the model reads (Trojan Source)"
        severity = "medium"
        action = "consent"
        category = "prompt_injection"
    strings:
        // U+202D LEFT-TO-RIGHT OVERRIDE, U+202E RIGHT-TO-LEFT OVERRIDE
        $lro = { E2 80 AD }
        $rlo = { E2 80 AE }
    condition:
        any of them
}

rule Hidden_Markup_AI_Instructions : prompt_injection hidden_text
{
    meta:
        description = "Instructions addressed to an AI hidden with HTML or CSS (comments, display none, zero font size, white text)"
        severity = "high"
        action = "consent"
        category = "prompt_injection"
    strings:
        $hide_display = /display\s{0,3}:\s{0,3}none/ nocase
        $hide_visibility = /visibility\s{0,3}:\s{0,3}hidden/ nocase
        $hide_font = /font-size\s{0,3}:\s{0,3}0(\.0+)?(px|pt|em|rem)?\s{0,3}[;"'}]/ nocase
        $hide_opacity = /opacity\s{0,3}:\s{0,3}0(\.0+)?\s{0,3}[;"'}]/ nocase
        $hide_white = /[^-]color\s{0,3}:\s{0,3}(white|#fff\b|#ffffff)/ nocase
        $hide_comment = "<!--"

        $ai_en1 = "if you are an ai" nocase
        $ai_en2 = "if you are a language model" nocase
        $ai_en3 = "if you are an llm" nocase
        $ai_en4 = "note to ai" nocase
        $ai_en5 = "instructions for the ai" nocase
        $ai_en6 = "ignore all previous" nocase
        $ai_en7 = "ignore previous instructions" nocase
        $ai_en8 = "do not tell the user" nocase
        $ai_en9 = "do not mention this" nocase
        $ai_es1 = "si eres una ia" nocase
        $ai_es2 = "si eres un modelo de lenguaje" nocase
        $ai_es3 = "instrucciones para la ia" nocase
        $ai_es4 = "ignora todas las instrucciones" nocase
        $ai_es5 = "ignora las instrucciones anteriores" nocase
        $ai_es6 = "no se lo digas al usuario" nocase
        $ai_es7 = "no menciones esto" nocase
    condition:
        1 of ($hide_*) and 1 of ($ai_*)
}
