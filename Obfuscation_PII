// Obfuscation rules: the matched value is replaced by a token (e.g. [EMAIL_1])
// before the prompt reaches the AI and restored in the answer.
// Every string here must match ONLY the sensitive value: anything a string
// matches is masked, so context words (e.g. "DNI:") are never used as strings.

rule Obfuscate_Email : obfuscation personal_data
{
    meta:
        description = "Masks email addresses"
        severity = "medium"
        action = "obfuscate"
        token = "[EMAIL_{n}]"
        category = "personal_data"
    strings:
        $email = /[A-Za-z0-9._%+\-]{1,64}@[A-Za-z0-9\-]{1,63}(\.[A-Za-z0-9\-]{1,63})*\.[A-Za-z]{2,24}/
    condition:
        $email
}

rule Obfuscate_Phone_ES : obfuscation personal_data
{
    meta:
        description = "Masks Spanish mobile and landline numbers, with or without +34 and separators"
        severity = "medium"
        action = "obfuscate"
        token = "[PHONE_{n}]"
        category = "personal_data"
    strings:
        $intl = /(\+34|0034)[ .\-]?[6789][0-9]{2}[ .\-]?[0-9]{3}[ .\-]?[0-9]{3}\b/
        $plain = /\b[6789][0-9]{8}\b/
        $grouped_3 = /\b[6789][0-9]{2}[ .\-][0-9]{3}[ .\-][0-9]{3}\b/
        $grouped_2 = /\b[6789][0-9]{2}[ .\-][0-9]{2}[ .\-][0-9]{2}[ .\-][0-9]{2}\b/
        $landline = /\b[89][0-9][ .\-][0-9]{3}[ .\-][0-9]{2}[ .\-][0-9]{2}\b/
    condition:
        any of them
}

rule Obfuscate_DNI_NIE : obfuscation personal_data
{
    meta:
        description = "Masks Spanish DNI and NIE numbers (valid control letters only)"
        severity = "high"
        action = "obfuscate"
        token = "[DNI_{n}]"
        category = "personal_data"
    strings:
        $dni = /\b[0-9]{8}[ \-]?[A-HJ-NP-TV-Za-hj-np-tv-z]\b/
        $nie = /\b[XYZxyz][ \-]?[0-9]{7}[ \-]?[A-HJ-NP-TV-Za-hj-np-tv-z]\b/
    condition:
        any of them
}

rule Obfuscate_CIF : obfuscation business
{
    meta:
        description = "Masks Spanish company tax IDs (CIF / NIF of legal entities)"
        severity = "low"
        action = "obfuscate"
        token = "[CIF_{n}]"
        category = "business"
    strings:
        $cif = /\b[ABCDEFGHJNPQRSUVW][ \-]?[0-9]{7}[0-9A-J]\b/
    condition:
        $cif
}

rule Obfuscate_IBAN : obfuscation financial
{
    meta:
        description = "Masks IBAN bank account numbers (Spanish and other SEPA countries)"
        severity = "high"
        action = "obfuscate"
        token = "[IBAN_{n}]"
        category = "financial"
    strings:
        $iban_es = /\bES[0-9]{2}( ?[0-9]{4}){5}\b/
        $iban_sepa = /\b(AT|BE|BG|CH|CY|CZ|DE|DK|EE|FI|FR|GB|GR|HR|HU|IE|IT|LT|LU|LV|MT|NL|NO|PL|PT|RO|SE|SI|SK)[0-9]{2}( ?[A-Z0-9]{4}){3,7}( ?[A-Z0-9]{1,3})?\b/
    condition:
        any of them
}

rule Obfuscate_Credit_Card : obfuscation financial
{
    meta:
        description = "Masks payment card numbers (Visa, Mastercard, Amex, Discover) with optional separators"
        severity = "critical"
        action = "obfuscate"
        token = "[CARD_{n}]"
        category = "financial"
    strings:
        $visa_mc_disc = /\b(4[0-9]{3}|5[1-5][0-9]{2}|2[2-7][0-9]{2}|6011|65[0-9]{2})([ \-]?[0-9]{4}){3}\b/
        $amex = /\b3[47][0-9]{2}[ \-]?[0-9]{6}[ \-]?[0-9]{5}\b/
    condition:
        any of them
}

rule Obfuscate_IPv4 : obfuscation network
{
    meta:
        description = "Masks IPv4 addresses"
        severity = "low"
        action = "obfuscate"
        token = "[IP_{n}]"
        category = "network"
    strings:
        $ipv4 = /\b(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}\b/
    condition:
        $ipv4
}

rule Obfuscate_SSN_US : obfuscation personal_data
{
    meta:
        description = "Masks US Social Security Numbers written as XXX-XX-XXXX"
        severity = "high"
        action = "obfuscate"
        token = "[SSN_{n}]"
        category = "personal_data"
    strings:
        $ssn = /\b[0-8][0-9]{2}-[0-9]{2}-[0-9]{4}\b/
    condition:
        $ssn
}

rule Obfuscate_API_Keys : obfuscation secrets
{
    meta:
        description = "Masks API keys and access tokens so the rest of the prompt can still be sent (AWS, Google, GitHub, GitLab, Slack, Stripe, OpenAI, Anthropic, Hugging Face)"
        severity = "critical"
        action = "obfuscate"
        token = "[API_KEY_{n}]"
        category = "secrets"
    strings:
        $aws_key_id = /\b(AKIA|ASIA)[A-Z0-9]{16}\b/
        $google_api_key = /AIza[0-9A-Za-z_\-]{35}/
        $github = /\bgh[pousr]_[A-Za-z0-9]{36}\b/
        $github_fine_grained = /\bgithub_pat_[A-Za-z0-9_]{82}/
        $gitlab = /\bglpat-[A-Za-z0-9_\-]{20}/
        $slack = /\bxox[abposr]-[0-9]{6,}-[A-Za-z0-9\-]{6,}/
        $stripe = /\b(sk|rk|pk)_(live|test)_[A-Za-z0-9]{24,}/
        $openai = /\bsk-(proj|svcacct|admin)-[A-Za-z0-9_\-]{40,}/
        $openai_legacy = /\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}/
        $anthropic = /\bsk-ant-(api|admin)[0-9]{2}-[A-Za-z0-9_\-]{80,}/
        $huggingface = /\bhf_[A-Za-z]{34}\b/
    condition:
        any of them
}
