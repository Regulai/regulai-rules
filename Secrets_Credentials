// Credentials and secrets that must never be sent to an external AI provider.
// Exact token formats use action block; heuristic detections use consent.

rule Private_Key_Material : secrets credentials
{
    meta:
        description = "Private key material (PEM, OpenSSH, PGP or PuTTY private keys)"
        severity = "critical"
        action = "block"
        category = "secrets"
    strings:
        $pem = /-----BEGIN ((RSA|DSA|EC|OPENSSH|ENCRYPTED|PGP) )?PRIVATE KEY( BLOCK)?-----/
        $putty = "PuTTY-User-Key-File-"
    condition:
        any of them
}

rule Cloud_Provider_Credentials : secrets credentials cloud
{
    meta:
        description = "AWS access and secret keys, GCP service account keys, Google API keys and Azure storage or service bus keys"
        severity = "critical"
        action = "block"
        category = "secrets"
    strings:
        $aws_key_id = /\b(AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}\b/
        $aws_secret = /aws_secret_access_key["']?\s{0,3}[:=]\s{0,3}["']?[A-Za-z0-9\/+]{40}/ nocase
        $gcp_sa_type = /"type"\s{0,3}:\s{0,3}"service_account"/
        $gcp_sa_key_id = /"private_key_id"\s{0,3}:\s{0,3}"[a-f0-9]{40}"/
        $google_api_key = /AIza[0-9A-Za-z_\-]{35}/
        $azure_account_key = /AccountKey=[A-Za-z0-9+\/]{80,}={0,2}/
        $azure_sas_key = /SharedAccessKey=[A-Za-z0-9+\/]{40,}={0,2}/
    condition:
        $aws_key_id or $aws_secret or ($gcp_sa_type and $gcp_sa_key_id)
        or $google_api_key or $azure_account_key or $azure_sas_key
}

rule SaaS_API_Tokens : secrets credentials
{
    meta:
        description = "Access tokens for GitHub, GitLab, Slack, Stripe, SendGrid and npm"
        severity = "critical"
        action = "block"
        category = "secrets"
    strings:
        $github_classic = /\bgh[pousr]_[A-Za-z0-9]{36}\b/
        $github_fine_grained = /\bgithub_pat_[A-Za-z0-9_]{82}/
        $gitlab = /\bglpat-[A-Za-z0-9_\-]{20}/
        $slack_token = /\bxox[abposr]-[0-9]{6,}-[A-Za-z0-9\-]{6,}/
        $slack_webhook = /hooks\.slack\.com\/services\/T[A-Z0-9]{8,}\/B[A-Z0-9]{8,}\/[A-Za-z0-9]{24}/
        $stripe_live = /\b(sk|rk)_live_[A-Za-z0-9]{24,}/
        $sendgrid = /\bSG\.[A-Za-z0-9_\-]{22}\.[A-Za-z0-9_\-]{43}/
        $npm = /\bnpm_[A-Za-z0-9]{36}\b/
    condition:
        any of them
}

rule AI_Provider_API_Keys : secrets credentials ai
{
    meta:
        description = "API keys for AI providers (OpenAI, Anthropic, Hugging Face, Groq, xAI)"
        severity = "critical"
        action = "block"
        category = "secrets"
    strings:
        $openai_project = /\bsk-(proj|svcacct|admin)-[A-Za-z0-9_\-]{40,}/
        $openai_legacy = /\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}/
        $anthropic = /\bsk-ant-(api|admin)[0-9]{2}-[A-Za-z0-9_\-]{80,}/
        $huggingface = /\bhf_[A-Za-z]{34}\b/
        $groq = /\bgsk_[A-Za-z0-9]{52}\b/
        $xai = /\bxai-[A-Za-z0-9]{80}/
    condition:
        any of them
}

rule JWT_Token : secrets credentials
{
    meta:
        description = "JSON Web Token (session or access token), may grant access to a live system"
        severity = "high"
        action = "consent"
        category = "secrets"
    strings:
        $jwt = /\beyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}/
    condition:
        $jwt
}

rule Credentials_In_Connection_String : secrets credentials
{
    meta:
        description = "User and password embedded in a URL or database connection string"
        severity = "high"
        action = "consent"
        category = "secrets"
    strings:
        $url_credentials = /:\/\/[^\s:@\/'"<>]{1,64}:[^\s:@\/'"<>]{3,128}@[A-Za-z0-9.\-]{2,}/
        $kv_password = /(Password|Pwd)\s{0,3}=\s{0,3}[^;\s'"]{3,}\s{0,3};/ nocase
        $kv_host = /(Server|Data Source|Host)\s{0,3}=/ nocase
    condition:
        $url_credentials or ($kv_password and $kv_host)
}

rule Secret_Assignment_In_Config : secrets credentials
{
    meta:
        description = "Password, secret or token assigned a value in code, .env or config files"
        severity = "medium"
        action = "consent"
        category = "secrets"
    strings:
        $assign = /(password|passwd|secret[_\-]?key|secret|api[_\-]?key|access[_\-]?token|auth[_\-]?token|client[_\-]?secret)["']?\s{0,3}[:=]\s{0,3}["']?[A-Za-z0-9!#$%&()+,.\/;<>?@^_{|}~\-]{8,}/ nocase
    condition:
        $assign
}

rule Kubernetes_Secret_Manifest : secrets credentials cloud
{
    meta:
        description = "Kubernetes Secret manifest (base64 values are credentials, not encryption)"
        severity = "high"
        action = "consent"
        category = "secrets"
    strings:
        $api_version = "apiVersion:"
        $kind = /kind:\s{0,3}Secret\b/
        $data = /\n\s{0,4}(data|stringData):\s{0,3}\r?\n/
    condition:
        all of them
}
